{
  "name": "anna-dsh",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:desktop": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-host.mjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:desktop": "node tests/desktop.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:dmg": "node scripts/create-dmg.mjs",
    "install:mac": "python3 scripts/install-mac.py"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.5-alpha.2",
    "@deepseek-ai/dsh": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@moeru/eventa": "0.3.0",
    "@pixi/unsafe-eval": "6.5.10",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "valibot": "1.1.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.4.1",
    "@types/node": "24.7.2",
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "44.7.0",
    "esbuild": "0.25.12",
    "eslint": "9.37.0",
    "playwright": "1.56.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.1"
  }
}
