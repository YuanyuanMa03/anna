{
  "name": "anna",
  "type": "module",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev:desktop": "node scripts/dev.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "build": "node scripts/fetch-assets.mjs && vite build && node scripts/build-host.mjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:desktop": "node tests/desktop.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:dmg": "node scripts/create-dmg.mjs",
    "install:mac": "python3 scripts/install-mac.py",
    "package:windows": "node scripts/package-windows.mjs",
    "package:windows-installer": "node scripts/package-windows-installer.mjs",
    "test:unconfigured": "node tests/unconfigured.mjs",
    "build:website": "node scripts/build-website.mjs",
    "dev:website": "vite --config website/vite.config.ts",
    "package:linux": "node scripts/package-linux.mjs",
    "package:deb": "node scripts/package-deb.mjs",
    "test:scripted": "node tests/desktop-scripted.mjs && node tests/onboarding.mjs && node tests/unconfigured.mjs",
    "deploy:website": "pnpm build:website && pnpm dlx --allow-build=esbuild --allow-build=workerd --allow-build=sharp wrangler@4.42.0 deploy --config website/wrangler.jsonc",
    "preflight": "node scripts/preflight.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@moeru/eventa": "0.3.0",
    "@pixi/unsafe-eval": "6.5.10",
    "@sherpaw/asr": "0.3.0",
    "@sherpaw/preloader": "0.3.0",
    "@sherpaw/shared": "0.3.0",
    "diff": "8.0.4",
    "mesh-avatar": "0.4.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "qrcode": "1.5.4",
    "valibot": "1.1.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.4.1",
    "@types/node": "24.7.2",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "44.7.0",
    "esbuild": "0.25.12",
    "eslint": "9.37.0",
    "playwright": "1.56.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.1"
  }
}
